# Kopiere diese Datei nach ".env.local" und trage deine Werte ein.
# ".env.local" wird NICHT ins Repository hochgeladen (siehe .gitignore).
# Auf Vercel trägst du dieselben Variablen unter
# Project → Settings → Environment Variables ein.

# --- Supabase (Project Settings → API / API Keys) ---------------------------
# Öffentliche Werte – dürfen im Browser landen, Schutz erfolgt über RLS.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DEIN_KEY

# --- Anthropic (console.anthropic.com → API Keys) --------------------------
# GEHEIM! Nur serverseitig verwendet. Niemals in den Chat oder ins Repo kopieren.
ANTHROPIC_API_KEY=sk-ant-DEIN_SCHLUESSEL
# Modell-ID. claude-haiku-5-5 ist das günstigste aktuelle Modell.
# Stärker (und teurer): claude-sonnet-5-5 oder claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5
# Denk-/Antwortaufwand: low | medium | high (leer lassen = Modellstandard).
# "low" ist am günstigsten und für einen Alltags-Assistenten meist ausreichend.
ANTHROPIC_EFFORT=low
# Maximale Ausgabe-Tokens pro KI-Aufruf (begrenzt Kosten und Antwortlänge).
AI_MAX_OUTPUT_TOKENS=4000

# --- Zugriff ----------------------------------------------------------------
# Kommagetrennte Liste der E-Mail-Adressen, die Jarvis nutzen dürfen.
# In Produktion PFLICHT – ist sie leer, kann sich niemand anmelden.
ALLOWED_EMAILS=deine.adresse@example.com

# --- Grenzen (optional, Standardwerte in Klammern) -------------------------
# RATE_LIMIT_CHAT_PER_MINUTE=10   (KI-Anfragen pro Minute und Nutzer)
# RATE_LIMIT_CHAT_PER_DAY=150     (KI-Anfragen pro Tag und Nutzer)
# RATE_LIMIT_API_PER_MINUTE=120   (sonstige API-Anfragen pro Minute)
# Zeitzone für Datumsangaben an die KI:
# APP_TIMEZONE=Europe/Berlin
